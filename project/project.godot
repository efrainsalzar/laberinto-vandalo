; Archivo de configuración de Godot. Se recomienda editarlo desde el editor (Proyecto > Configuración del proyecto).

config_version=5

[application]

config/name="Laberinto Vándalo"
config/description="Torneo en un laberinto vivo: consigue el trofeo y vuelve a tu base antes de que los vándalos lo roben."
config/version="0.0.20"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
App="*res://scripts/autoload/app.gd"
UiFx="*res://scripts/autoload/ui_fx.gd"
Perf="*res://scripts/autoload/perf_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/theme.tres"

